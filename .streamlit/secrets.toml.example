# COPIA questo file in `.streamlit/secrets.toml` e NON committarlo mai.
# .gitignore lo esclude apposta.

# Chiave gratuita dalla Transparency Platform ENTSO-E (https://transparency.entsoe.eu).
# Serve per i dati reali: workspace "Dati reali svizzeri" e tab Swissix con sorgente "ENTSO-E live".
ENTSOE_API_KEY = "incolla-qui-la-tua-chiave"

# Password del terminale Streamlit (obbligatoria, nessun default nel codice).
APP_PASSWORD = "scegli-una-password"
